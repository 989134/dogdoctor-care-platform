# Copy these values into your local .env and adjust the port for your board.
# Windows examples: COM3, COM10
# Raspberry Pi/Linux examples: /dev/ttyUSB0, /dev/ttyACM0
UART_ENABLED=1
UART_DRY_RUN=0
UART_PORT=COM10
UART_BAUD=115200
UART_DEFAULT_SPEED=80
UART_TURN_SPEED=65

# Optional: disable RTSP result push if you only want the Flask MJPEG page.
ENABLE_PUSH_RESULT=1
RTSP_OUTPUT_URL=rtsp://10.238.167.243:8554/result
